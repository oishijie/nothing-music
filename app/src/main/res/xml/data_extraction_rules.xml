<?xml version="1.0" encoding="utf-8"?>
<!-- 凭证密文与 Android Keystore 密钥绑定，云备份/换机迁移后均无法解密。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="mica_remote_credentials_v1.xml" />
        <exclude domain="file" path="local_artwork/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mica_remote_credentials_v1.xml" />
        <exclude domain="file" path="local_artwork/" />
    </device-transfer>
</data-extraction-rules>
